# ============================================================================
# Nexus AI - Example environment configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ============================================================================

# ---- Application ----
# "development" | "production" | "test"
APP_ENV=development
# "debug" | "info" | "warning" | "error"
LOG_LEVEL=info
# Comma-separated list of allowed CORS origins (frontend dev server, etc.)
CORS_ORIGINS=http://localhost:5173

# ---- Database (Neon / local Postgres) ----
# Milestone 1 does NOT require this yet; it becomes required in Milestone 2.
# Neon gives you a connection string like:
#   postgresql+psycopg://USER:PASSWORD@HOST/dbname?sslmode=require
DATABASE_URL=

# ---- AI providers (added in Milestone 3; leave blank for now) ----
# Google AI Studio (Gemini) API key for generation + embeddings.
GEMINI_API_KEY=
# Default generation + embedding model names (swappable).
LLM_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-001

# ---- Reranker (added in Milestone 4; leave blank for now) ----
COHERE_API_KEY=

# ---- Auth / JWT (Milestone 7) ----
# Use a long, random secret in production (>= 32 bytes). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=1440
